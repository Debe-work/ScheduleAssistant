# Copy variable names to ~/secrets/schedule-assistant.env (do NOT put real values here)
# Use direnv: see .envrc.example
# Worker secrets live in worker/.dev.vars and are not part of this file.

VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_TEMPLATE_SOURCE=local
VITE_WORKER_BASE_URL=http://localhost:8787
